---
// Preguntas frecuentes: banda clara; titular a la izquierda (fijo al hacer scroll en escritorio, con `cta` opcional)
// y acordeón nativo <details>/<summary> a la derecha, sin JavaScript, con un «+» en señal redonda que gira al abrir.
// Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta.
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <section id={id} class="banda banda-clara seccion">
      <div class="contenedor grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
            {s.cta?.url && <a class="btn mt-9" href={s.cta.url}>{s.cta.texto}</a>}
          </div>
        </div>
        <div class="lg:col-span-7">
          {preguntas.map((p, i) => (
            <details class="faq" open={i === 0}>
              <summary>
                {p.pregunta}
                <span class="faq-signo" aria-hidden="true">+</span>
              </summary>
              <p>{p.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
