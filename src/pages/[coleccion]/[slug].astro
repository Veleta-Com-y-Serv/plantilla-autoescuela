---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /permisos/<slug>/.
// Diseño «señal de tráfico»: banda azul noche con migas y cabecera partida (título grande, texto, placa de precio y
// botones de matrícula y WhatsApp; a la derecha la foto con filete o, sin foto, la señal redonda con su icono); banda
// amarilla con el `detalle` y, al lado, el panel vial con los datos; franja de fotos (`imagenes`) sobre asfalto y
// otros permisos de la misma lista en una rejilla vial sobre fondo claro.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(f.idSeccion) },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const matricula = seccion('matricula') ? enlace('/#matricula') : site.boton_cabecera?.url || enlace('/#contacto');
const textoMatricula = site.boton_cabecera?.texto || 'Matricúlate';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="banda banda-noche ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {f.precio && <p class="ficha-chips"><span class="precio-placa">{f.precio}</span></p>}
          <div class="ficha-botones">
            <a class="btn btn-amarillo" href={matricula}>{textoMatricula}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true">
            <span class="senal-redonda"><Icono nombre={f.icono || 'senal'} tam={80} /></span>
          </div>
        )}
      </div>
    </div>
  </section>
  <span class="marca-vial" aria-hidden="true" style="--marca: var(--c-primario)"></span>

  <section class="banda banda-amarilla ficha-banda">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="panel-vial ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd>{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita">
          <p class="ficha-cita-titulo">¿Hablamos de tu caso?</p>
          <p>Te contamos cómo es el curso, cuándo empieza y qué trámites hacemos por ti.</p>
          <a class="btn" href={matricula}>{textoMatricula}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="banda banda-asfalto ficha-banda" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="banda banda-clara ficha-banda">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo={`Otros ${nombreSeccion.toLowerCase()}`} />
      </div>
      <div class="contenedor">
        <ul class="rejilla-vial" style={`--cols:${otras.length}`}>
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="senal-redonda ficha-otra-senal"><Icono nombre={o.icono || 'senal'} tam={28} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="precio-placa">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
      </div>
      <div class="contenedor">
        <p class="mt-10"><a class="btn-sec" href={rutaDeSeccion(f.idSeccion)}>Ver todos los {nombreSeccion.toLowerCase()}</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .ficha-banda { padding-block: clamp(3rem, 6vw, 5.5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .5; }
  .migas a { color: inherit; text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.5rem, 7vw, 5rem); overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.5rem; }
  .ficha-chips .precio-placa { background: var(--c-acento); color: var(--c-sobre-acento); font-size: 1.3rem; }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; border-radius: calc(var(--radio) * 1.6); overflow: hidden; box-shadow: 0 0 0 .4rem var(--c-acento), 0 0 0 .7rem #fff; }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; max-height: 18rem; }
  .ficha-icono .senal-redonda { width: clamp(8rem, 30vw, 11rem); box-shadow: 0 0 0 .5rem var(--c-acento), 0 0 0 .8rem #fff; }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.12rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.3rem; font-weight: 600; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.5rem; margin-bottom: 1rem; }
  .ficha-datos { padding: 2.25rem 1.75rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid rgb(255 255 255 / .25); }
  .ficha-datos dt { font-weight: 700; opacity: .8; }
  .ficha-datos dd { text-align: right; font-weight: 700; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; border: 3px solid var(--c-primario); border-radius: calc(var(--radio) * 1.6); padding: 1.75rem 1.5rem; }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-size: 1.7rem; font-weight: 700; line-height: 1.1; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: inherit; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: var(--radio); overflow: hidden; }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .8rem; }
  .ficha-otra-senal { width: 4.25rem; }
  .ficha-otra h3 { font-size: 1.7rem; margin-top: .5rem; overflow-wrap: anywhere; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 3px solid var(--c-primario); outline-offset: -6px; }
  .ficha-otra p { opacity: .85; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 750; }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
